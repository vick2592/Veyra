# Veyra — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Identity: World ID ─────────────────────────────────
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION_ENROLL=enroll-principal
WORLD_ACTION_ELEVATE=elevate-tier
WORLD_ALLOW_LEGACY_PROOFS=true

# ── Secret custody ──────────────────────────────────────
# VAULT_DRIVER=env lets anyone develop without a Ledger.
# VAULT_DRIVER=lkrp is for the machine holding the physical key.
VAULT_DRIVER=env
LKRP_KEY_NAME=warden-secrets
WALLET_PASS=

# ── Chain ───────────────────────────────────────────────
RPC_URL=
CHAIN_ID=84532
REGISTRY_ADDRESS=
EMITTER_PRIVATE_KEY=

# ── Data ────────────────────────────────────────────────
DATABASE_URL=
SUBGRAPH_QUERY_URL=

# ── Policy ──────────────────────────────────────────────
CAPABILITY_TTL_SECONDS=90
CONFIRMATION_TTL_SECONDS=120
TIER_TTL_SECONDS=3600
CONFIRMATION_THRESHOLD_USD=25

# ── AI ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
